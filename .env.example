# Salin file ini jadi .env.local untuk menjalankan halaman admin di komputer sendiri.
# File .env.local TIDAK ikut Git.
#
# Di produksi, isi nilainya lewat dashboard Netlify:
#   Site configuration -> Environment variables -> Add a variable
#
# Password untuk membuka /admin. Kalau dikosongkan, halaman admin terkunci total.
ADMIN_PASSWORD=
